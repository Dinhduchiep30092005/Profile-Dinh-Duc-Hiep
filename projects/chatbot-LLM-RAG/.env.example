# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# SerpAPI
SERPAPI_KEY=your-serpapi-key-here

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/seo_bot

# Bot Settings
DEFAULT_LANGUAGE=en
SERP_RESULTS_COUNT=20
CONTENT_MIN_WORDS=1500
CONTENT_MAX_WORDS=3000

# Google Search Console
GSC_CREDENTIALS_PATH=path/to/service-account.json
GSC_SITE_URL=https://your-site.com
